ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
# Never enable password test authentication in cloud.
ALLOW_TEST_PASSWORD_AUTH=false
# Server only; never use VITE_* for mail credentials.
APP_ORIGIN=https://pos-mexico-mvp.pages.dev
PIN_RECOVERY_FROM=POS México <acceso@your-verified-domain.example>
RESEND_API_KEY=
# Local capture only, with loopback APP_ORIGIN and ALLOW_TEST_PASSWORD_AUTH=true:
# TEST_MAILPIT_URL=http://supabase_inbucket_pos-mexico-pwa:8025

# Point: server-only secrets; both environment and business flags default off.
POINT_CHARGES_ENABLED=false
MP_ENVIRONMENT=sandbox
# Official virtual terminal only. Set the application test token privately in server secrets.
MP_TEST_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://pos-mexico-mvp.pages.dev/point/callback
# JSON map of key ID -> 32 random bytes encoded base64url. Do not commit real keys.
MP_TOKEN_KEYS={}
MP_TOKEN_ACTIVE_KEY=
MP_WEBHOOK_SECRET=
# Signature secret for the separate official sandbox application; coexist with live.
MP_WEBHOOK_TEST_SECRET=
# Keep previous signature secret during the provider's retry/rotation window.
MP_WEBHOOK_PREVIOUS_SECRET=
POINT_WORKER_SECRET=
# Only the explicitly enabled loopback development/CI stack can enable these overrides.
MP_ALLOW_LOCAL_SIMULATOR=false
# Dev-only authorization URL; rejected outside the local sandbox. Normally omitted.
# MP_OAUTH_AUTHORIZATION_URL=http://127.0.0.1:8187/authorization
