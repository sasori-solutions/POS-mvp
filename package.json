{
  "name": "pos-mexico-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:stop": "node scripts/dev.mjs --stop",
    "test:dev": "node tests/integration/development-login-smoke.mjs",
    "build": "tsc -b && vite build && node scripts/check-production.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,postgres-meta,studio,logflare,vector,supavisor",
    "db:reset": "node scripts/reset-disposable.mjs",
    "api:serve": "supabase functions serve account --env-file .env.functions",
    "check": "npm run test && npm run build",
    "check:live": "node scripts/check-live.mjs",
    "lint": "oxlint src supabase/functions tests --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test:sql": "vitest run tests/sql",
    "test:domain": "vitest run tests/unit",
    "test:smoke": "vitest run tests/unit",
    "test:provider": "npx --yes deno test --allow-net=127.0.0.1,localhost tests/provider/adapter.deno.ts",
    "test:point:integration": "vitest run tests/integration/point.integration.test.ts --no-file-parallelism --maxWorkers=1 --testTimeout=30000 --hookTimeout=60000",
    "test:point:local": "node scripts/test-point-local-integration.mjs",
    "test:integrity": "vitest run tests/unit tests/sql/financial-integrity.test.ts tests/sql/financial-adjustments.test.ts tests/components/financial-state-integrity.test.tsx tests/components/financial-legacy-state-integrity.test.tsx tests/components/checkout-adjustments.test.tsx tests/components/checkout-reservation.test.tsx tests/components/counter-checkout.test.tsx tests/components/checkout-item-selection.test.tsx tests/components/order-discount-editor.test.tsx tests/components/live-operational-attempts.test.tsx tests/components/operational-recovery.test.tsx --maxWorkers=2",
    "test:integrity:integration": "node scripts/test-financial-integration.mjs",
    "check:ledger": "node scripts/check-financial-ledger.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.49.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "19.3.0",
    "react-number-format": "^5.4.5",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
