{
  "name": "pos-mexico-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,postgres-meta,studio,logflare,vector,supavisor",
    "db:reset": "supabase db reset",
    "api:serve": "supabase functions serve account --env-file .env.functions",
    "check": "npm run test && npm run build",
    "check:live": "node scripts/check-live.mjs",
    "lint": "oxlint src supabase/functions tests --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test:sql": "vitest run tests/sql",
    "test:domain": "vitest run tests/unit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.49.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "jsqr": "^1.4.0",
    "supabase": "^2.119.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
